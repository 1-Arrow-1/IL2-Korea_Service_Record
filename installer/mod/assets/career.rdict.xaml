	<ControlTemplate x:Key="Vector.Career_Mission_UnitLostIndicator">
		<Canvas Width="30" Height="30">
			<Path StrokeThickness="4"
			      Stroke="{StaticResource Brush.Dark_Olive_Drab}"
			      Data="M2,2 L28,28 M2,28 L28,2" />
			<Path StrokeThickness="2"
			      Stroke="{StaticResource Brush.Lite_Olive_Drab}"
			      Data="M2,2 L28,28 M2,28 L28,2" />
		</Canvas>
	</ControlTemplate>

	<ControlTemplate x:Key="Vector.Career_PlaneIcon">
		<Path Stretch="Uniform"
		      StrokeThickness="{app:RoundToPixels 1}"
		      Stroke="{TemplateBinding app:Brushes.Stroke}"
		      Fill="{TemplateBinding app:Brushes.Fill}"
		      StrokeDashArray="10 4"
		      Data="{TemplateBinding app:Brushes.Geometry}" />
	</ControlTemplate>

