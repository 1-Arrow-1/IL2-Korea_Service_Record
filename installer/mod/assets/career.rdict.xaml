	<ControlTemplate x:Key="Template.Career_StatusProgress">
		<Canvas Width="20" Height="20"
		        Background="{TemplateBinding Background}">
			<Ellipse Canvas.Left="3.5" Canvas.Top="3.5"
			         Width="13" Height="13"
			         Stroke="{StaticResource Brush.Insignia_White}"
			         Fill="{StaticResource Brush.Insignia_White}" />
			<Viewbox Canvas.Left="4.5" Canvas.Top="4.5"
			         Width="11" Height="11"
			         RenderTransformOrigin="0.5,0.5">
				<Viewbox.RenderTransform>
					<ScaleTransform ScaleX="-1" />
				</Viewbox.RenderTransform>
				<Path Width="100" Height="100"
				      Fill="{TemplateBinding Background}"
				      noesis:Element.PPAAOut="1">
					<Path.Data>
						<MultiBinding Converter="{StaticResource ProgressToGeometryConverter}">
							<Binding Path="DataContext.StatusProgress" RelativeSource="{RelativeSource TemplatedParent}" />
							<Binding Path="." Source="{StaticResource Float0}" />
							<Binding Path="." Source="{StaticResource Float1}" />
						</MultiBinding>
					</Path.Data>
				</Path>
			</Viewbox>
		</Canvas>
	</ControlTemplate>

