	<Style x:Key="Style.DayEventItem" TargetType="ListBoxItem">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="{app:BrushOffset {StaticResource NoiseBrush.Dark_Olive_Drab}}" />
		<Setter Property="Focusable" Value="False" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate>
					<Grid Background="{TemplateBinding Background}">
						<ContentPresenter Margin="2,8" />
						<Line x:Name="Separator"
						      VerticalAlignment="Bottom"
						      StrokeThickness="1"
						      Stroke="{TemplateBinding Foreground}"
						      StrokeDashArray="2 2"
						      X1="0"
						      X2="{TemplateBinding ActualWidth}" />
					</Grid>
					<ControlTemplate.Triggers>
						<DataTrigger Binding="{app:IsLastItem}" Value="True">
							<Setter TargetName="Separator" Property="Visibility" Value="Collapsed" />
						</DataTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<DataTemplate x:Key="DataTemplate.DayEventItem.Short">
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="6" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="10" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<ContentControl Grid.Column="0"
			                Foreground="{app:BrushOffset {StaticResource NoiseBrush.Dark_Olive_Drab}}"
			                Style="{StaticResource Style.EventIcon}"
			                Content="{Binding Icon}" />

			<TextBlock Grid.Column="2"
			           VerticalAlignment="Center"
			           Foreground="{app:BrushOffset {StaticResource NoiseBrush.Neutral_Gray}}"
			           FontFamily="{StaticResource Font.Inter}"
			           FontWeight="Medium"
			           FontSize="14"
			           Text="{Binding Date.Time}"
			           d:Text="21" />

			<TextBlock Grid.Column="4"
			           HorizontalAlignment="Left"
			           VerticalAlignment="Center"
			           Foreground="{app:BrushOffset {StaticResource NoiseBrush.Dark_Olive_Drab}}"
			           FontFamily="{StaticResource Font.Inter}"
			           FontWeight="Medium"
			           FontSize="14"
			           TextWrapping="Wrap"
			           app:Text.RichText="{Binding Text}"
			           d:Text="22121" />
		</Grid>
	</DataTemplate>

