	<ControlTemplate x:Key="Template.BGPaper_Overlay_Animated_By_IsEnabled">
		<Border x:Name="Filler" Visibility="Collapsed">
			<Border.Background>
				<ImageBrush ImageSource="{StaticResource Menu.BG_paper}"
				            Stretch="Fill" TileMode="Tile"
				            Opacity="0"
				            Viewport="0,0,1024,512"
				            ViewportUnits="Absolute" />
			</Border.Background>
		</Border>
		<ControlTemplate.Triggers>
			<Trigger Property="IsEnabled" Value="False">
				<Trigger.EnterActions>
					<BeginStoryboard>
						<Storyboard>
							<DoubleAnimation Storyboard.TargetName="Filler"
							                 Storyboard.TargetProperty="Background.(ImageBrush.Opacity)"
							                 Duration="{StaticResource Duration.ShortAnimation}"
							                 From="0" To="0.6" />
							<ObjectAnimationUsingKeyFrames Storyboard.TargetName="Filler" Storyboard.TargetProperty="Visibility">
								<DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
							</ObjectAnimationUsingKeyFrames>
						</Storyboard>
					</BeginStoryboard>
				</Trigger.EnterActions>
				<Trigger.ExitActions>
					<BeginStoryboard>
						<Storyboard>
							<DoubleAnimation Storyboard.TargetName="Filler"
							                 Storyboard.TargetProperty="Background.(ImageBrush.Opacity)"
							                 Duration="{StaticResource Duration.ShortAnimation}"
							                 From="0.6" To="0" />
							<ObjectAnimationUsingKeyFrames Storyboard.TargetName="Filler" Storyboard.TargetProperty="Visibility">
								<DiscreteObjectKeyFrame KeyTime="{StaticResource KeyTime.ShortAnimationEnd}"
								                        Value="{x:Static Visibility.Collapsed}" />
							</ObjectAnimationUsingKeyFrames>
						</Storyboard>
					</BeginStoryboard>
				</Trigger.ExitActions>
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>

	<Style x:Key="Template.Career_UnitsItemsControl" TargetType="ItemsControl"
	       BasedOn="{StaticResource {x:Type ItemsControl}}">
		<Style.Resources>

			<ControlTemplate x:Key="Template.UnitGroup">
				<ControlTemplate.Resources>
					<Storyboard x:Key="AnimCollapse">
						<DoubleAnimation FillBehavior="Stop"
						                 Storyboard.TargetName="UnitContent"
						                 Storyboard.TargetProperty="MaxWidth"
						                 Duration="{StaticResource Duration.ShortAnimation}"
						                 From="120" To="0">
							<DoubleAnimation.EasingFunction>
								<CubicEase EasingMode="EaseIn" />
							</DoubleAnimation.EasingFunction>
						</DoubleAnimation>
					</Storyboard>
				</ControlTemplate.Resources>
				<Grid IsEnabled="{Binding IsEnabled}">
					<b:Interaction.Triggers>
						<b:DataTrigger Binding="{Binding PlayFadeIn}" Value="True">
							<b:ControlStoryboardAction>
								<b:ControlStoryboardAction.Storyboard>
									<Storyboard x:Name="AnimFadeIn">
										<DoubleAnimation FillBehavior="Stop"
										                 Storyboard.TargetName="UnitContent"
										                 Storyboard.TargetProperty="Opacity"
										                 Duration="{StaticResource Duration.ShortAnimation}"
										                 From="0" To="1" />
									</Storyboard>
								</b:ControlStoryboardAction.Storyboard>
							</b:ControlStoryboardAction>
						</b:DataTrigger>
						<b:StoryboardCompletedTrigger Storyboard="{Binding ElementName=AnimFadeIn}">
							<b:ChangePropertyAction PropertyName="PlayFadeIn"
							                        TargetObject="{Binding}"
							                        Value="False" />
						</b:StoryboardCompletedTrigger>

						<b:DataTrigger Binding="{Binding PlayFadeOut}" Value="True">
							<b:ControlStoryboardAction>
								<b:ControlStoryboardAction.Storyboard>
									<Storyboard x:Name="AnimFadeOut">
										<DoubleAnimation FillBehavior="Stop"
										                 Storyboard.TargetName="UnitContent"
										                 Storyboard.TargetProperty="Opacity"
										                 Duration="{StaticResource Duration.ShortAnimation}"
										                 From="1" To="0" />
									</Storyboard>
								</b:ControlStoryboardAction.Storyboard>
							</b:ControlStoryboardAction>
						</b:DataTrigger>
						<b:StoryboardCompletedTrigger Storyboard="{Binding ElementName=AnimFadeOut}">
							<b:InvokeCommandAction Command="{Binding Owner.RemoveUnit}" CommandParameter="{Binding}" />
						</b:StoryboardCompletedTrigger>

						<b:DataTrigger Binding="{Binding PlayCollapse}" Value="True">
							<b:ControlStoryboardAction Storyboard="{StaticResource AnimCollapse}" />
						</b:DataTrigger>

					</b:Interaction.Triggers>
					<com:FlatButton x:Name="UnitButton"
					                Margin="-1,0"
					                IsHitTestVisible="{Binding IsPendingDelete, Converter={StaticResource IsFalse}}"
					                Style="{StaticResource Style.FlatButton_Career_UnitGroup}"
					                ContextMenu="{StaticResource ContextMenu.Career_UnitGroup_UnitMenu}"
					                ContextMenuService.HasDropShadow="True"
					                ContextMenuService.IsEnabled="False"
					                ContextMenuService.Placement="Right"
					                Command="{Binding Owner.UnitAction}"
					                CommandParameter="{Binding}"
					                HoverCommand="{Binding Owner.SetHighlight}"
					                HoverLostCommand="{Binding Owner.ClearHighlight}">
						<com:FlatButton.ContextMenuOnClick>
							<MultiBinding Converter="{StaticResource BooleanAnd}">
								<Binding Path="Owner.CanShowMenu" />
								<Binding Path="IsPendingDelete" Converter="{StaticResource IsFalse}" />
							</MultiBinding>
						</com:FlatButton.ContextMenuOnClick>
					</com:FlatButton>
					<Grid x:Name="UnitPanel"
					      Background="Transparent"
					      IsHitTestVisible="False">
						<Control x:Name="UnitContent"
						         HorizontalAlignment="Center"
						         Margin="12,0"
						         Template="{Binding ItemType, Converter={StaticResource Career_UnitGroup_Slot_Content}}" />

						<Control Template="{StaticResource Template.BGPaper_Overlay_Animated_By_IsEnabled}"
						         IsEnabled="{Binding IsEnabled}" />

						<Grid x:Name="WatchmenPanel"
						      Width="{Binding ActualWidth, ElementName=UnitPanel}"
						      Height="{Binding ActualHeight, ElementName=UnitPanel}"
						      Visibility="Collapsed">

							<Grid.Resources>
								<Style x:Key="PathLeftRight" TargetType="Path" BasedOn="{StaticResource Style.Shape_SeaBlue_4px_Stretch}">
									<Setter Property="StrokeDashArray" Value="8,2" />
									<Setter Property="Data" Value="M0,0 v300" />
								</Style>
								<Style x:Key="PathTopBottom" TargetType="Path" BasedOn="{StaticResource Style.Shape_SeaBlue_4px_Stretch}">
									<Setter Property="StrokeDashArray" Value="8,2" />
									<Setter Property="StrokeStartLineCap" Value="Square" />
									<Setter Property="StrokeEndLineCap" Value="Square" />
									<Setter Property="Margin" Value="-1,0,0,0" />
									<Setter Property="Data" Value="M0,0 h300" />
								</Style>
							</Grid.Resources>

							<Path HorizontalAlignment="Left"
							      Margin="-1,0,0,0"
							      Style="{StaticResource PathLeftRight}"
							      Visibility="{Binding IsWatchmenStart, Converter={StaticResource BoolToVis}}" />

							<Path HorizontalAlignment="Right"
							      Margin="0,0,-1,0"
							      Style="{StaticResource PathLeftRight}"
							      Visibility="{Binding IsWatchmenEnd, Converter={StaticResource BoolToVis}}" />

							<Path VerticalAlignment="Top" Style="{StaticResource PathTopBottom}" />
							<Path VerticalAlignment="Bottom" Style="{StaticResource PathTopBottom}" />

							<Border Width="20" Height="20"
							        HorizontalAlignment="Left"
							        VerticalAlignment="Top"
							        Background="{StaticResource Brush.Sea_Blue}"
							        Visibility="{Binding IsWatchmenStart, Converter={StaticResource BoolToVis}}">
								<TextBlock HorizontalAlignment="Center"
								           VerticalAlignment="Center"
								           Foreground="{StaticResource Brush.Insignia_White}"
								           Style="{StaticResource Style.ARM_Title_Small_1}"
								           Text="{app:Localize carWatchmenLabel}" />
							</Border>

						</Grid>

						<Grid x:Name="SelectionPanel"
						      Width="{Binding ActualWidth, ElementName=UnitPanel}"
						      Height="{Binding ActualHeight, ElementName=UnitPanel}"
						      Margin="0,0,-1,0"
						      noesis:Element.PPAAMode="Disabled"
						      Visibility="Collapsed" d:Visibility="Visible">
							<Grid.Resources>
								<Style TargetType="Path" BasedOn="{StaticResource Style.Shape_OliveDrab_4px_Stretch}" />
								<Style x:Key="PathTopBottom" TargetType="Path" BasedOn="{StaticResource Style.Shape_OliveDrab_4px_Stretch}">
									<Setter Property="StrokeStartLineCap" Value="Square" />
									<Setter Property="StrokeEndLineCap" Value="Square" />
									<Setter Property="Margin" Value="-1,0,0,0" />
									<Setter Property="Data" Value="M0,0 h300" />
								</Style>
							</Grid.Resources>

							<Path HorizontalAlignment="Left"
							      Margin="-1,0,0,0"
							      Data="M0,0 v300"
							      Visibility="{Binding IsSelectionStart, Converter={StaticResource BoolToVis}}" />

							<Path HorizontalAlignment="Right"
							      Margin="0,0,-1,0"
							      Data="M0,0 v300"
							      Visibility="{Binding IsSelectionEnd, Converter={StaticResource BoolToVis}}" />

							<Path VerticalAlignment="Top" Style="{StaticResource PathTopBottom}" />
							<Path VerticalAlignment="Bottom" Style="{StaticResource PathTopBottom}" />

						</Grid>

						<Grid x:Name="HighlightPanel"
						      Height="{Binding ActualHeight, ElementName=UnitPanel}"
						      Margin="0,0,-1,0"
						      noesis:Element.PPAAMode="Disabled"
						      Visibility="Collapsed">
							<Grid.Resources>
								<Style TargetType="Path" BasedOn="{StaticResource Style.Shape_OliveDrab_4px}" />
							</Grid.Resources>

							<Path HorizontalAlignment="Left"
							      VerticalAlignment="Top"
							      Data="M1,24 v-22h22"
							      Visibility="{Binding IsHighlightStart, Converter={StaticResource BoolToVis}}" />

							<Path HorizontalAlignment="Left"
							      VerticalAlignment="Bottom"
							      Data="M1,0 v22h22"
							      Visibility="{Binding IsHighlightStart, Converter={StaticResource BoolToVis}}" />

							<Path HorizontalAlignment="Right"
							      VerticalAlignment="Top"
							      Data="M24,24 v-22h-22"
							      Visibility="{Binding IsHighlightEnd, Converter={StaticResource BoolToVis}}" />

							<Path HorizontalAlignment="Right"
							      VerticalAlignment="Bottom"
							      Data="M24,1 v22h-22"
							      Visibility="{Binding IsHighlightEnd, Converter={StaticResource BoolToVis}}" />

						</Grid>
					</Grid>

				</Grid>
				<ControlTemplate.Triggers>
					<DataTrigger Binding="{app:IsMouseNavigation}" Value="True">
						<Setter TargetName="UnitButton" Property="ContextMenuService.Placement" Value="MousePoint" />
					</DataTrigger>
					<MultiDataTrigger>
						<MultiDataTrigger.Conditions>
							<Condition Binding="{Binding IsSelected}" Value="True" />
							<Condition Binding="{Binding Owner.HideSelection}" Value="False" />
						</MultiDataTrigger.Conditions>
						<Setter TargetName="SelectionPanel" Property="Visibility" Value="Visible" />
					</MultiDataTrigger>
					<DataTrigger Binding="{Binding IsHighlighted}" Value="True">
						<Setter TargetName="HighlightPanel" Property="Visibility" Value="Visible" />
						<Setter TargetName="UnitPanel" Property="Background" Value="{StaticResource Brush.Hover_White}" />
					</DataTrigger>
					<DataTrigger Binding="{Binding IsWatchmen}" Value="True">
						<Setter TargetName="WatchmenPanel" Property="Visibility" Value="Visible" />
					</DataTrigger>
				</ControlTemplate.Triggers>
			</ControlTemplate>

			<ControlTemplate x:Key="Template.Gap">
				<Decorator Width="22" />
			</ControlTemplate>

			<app:IfTrue x:Key="IsGapToTemplate"
			            Then="{StaticResource Template.Gap}"
			            Else="{StaticResource Template.UnitGroup}" />

		</Style.Resources>

		<Setter Property="Margin" Value="1,0,0,0" />
		<Setter Property="Focusable" Value="{Binding HasSelectableUnits}" />
		<Setter Property="app:Focus.DefaultFocusItem" Value="{x:Static app:FocusItem.First}" />
		<Setter Property="ItemsSource" Value="{Binding Units}" />
		<Setter Property="ItemTemplate">
			<Setter.Value>
				<DataTemplate>
					<Control Template="{Binding IsGap, Converter={StaticResource IsGapToTemplate}}">
						<d:Control.Template>
							<ControlTemplate />
						</d:Control.Template>
					</Control>
				</DataTemplate>
			</Setter.Value>
		</Setter>
		<Setter Property="ItemContainerStyle">
			<Setter.Value>
				<Style TargetType="ContentPresenter">
					<!-- Otherwise highlighted background covers selection lines -->
					<Setter Property="Panel.ZIndex" Value="{Binding IsHighlighted, Converter={app:IfTrue -1, Else=0}}" />
				</Style>
			</Setter.Value>
		</Setter>
		<Setter Property="ItemsPanel">
			<Setter.Value>
				<ItemsPanelTemplate>
					<StackPanel Orientation="Horizontal" />
				</ItemsPanelTemplate>
			</Setter.Value>
		</Setter>
		<Setter Property="noesis:StyleInteraction.Triggers">
			<Setter.Value>
				<noesis:StyleTriggerCollection>
					<noesis:DataEventTrigger Source="{Binding}" EventName="FocusRequested">
						<app:ChangeFocusAction />
					</noesis:DataEventTrigger>
				</noesis:StyleTriggerCollection>
			</Setter.Value>
		</Setter>
	</Style>

