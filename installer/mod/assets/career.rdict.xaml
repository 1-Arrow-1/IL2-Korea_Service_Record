		<Setter Property="ItemContainerStyle">
			<Setter.Value>
				<Style TargetType="ContentControl">
					<Setter Property="Grid.Column"
					        Value="{Binding Date.Day, Converter={StaticResource AddConverter}, ConverterParameter=-1}" />
					<Setter Property="Grid.Row"
					        Value="{Binding Date.Month, Converter={StaticResource AddConverter}, ConverterParameter=-1}" />
					<Setter Property="IsHitTestVisible" Value="True" />
