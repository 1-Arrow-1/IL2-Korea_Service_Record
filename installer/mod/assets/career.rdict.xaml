	<Style x:Key="Style.Career_MissionMap_Point" TargetType="Control">
		<Setter Property="Focusable" Value="False" />
		<Setter Property="Foreground" Value="{Binding Color, Converter={StaticResource Coalition.TeamColorsMap}}" />
		<Setter Property="app:Brushes.Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource Self}}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Control">
					<Grid>
						<!-- Operation Name -->
						<!--<Border VerticalAlignment="Center"
						        Margin="18,-25,0,25"
						        CornerRadius="0,2,2,0"
						        BorderThickness="0,0.5,0.5,0.5"
						        BorderBrush="{TemplateBinding Foreground}"
						        Background="{StaticResource Brush.Insignia_White.50}"
						        noesis:Element.PPAAOut="1.0"
						        Visibility="{Binding IsOperation, Converter={StaticResource BoolToVis}}">
							<TextBlock Margin="6,1"
							           FontFamily="{StaticResource Font.Inter}"
							           FontWeight="SemiBold"
							           FontSize="10"
							           app:Text.IsUpperCase="True"
							           Text="{app:Localize Binding={Binding DisplayName}}"/>
						</Border>-->

						<Grid>
							<Grid.RenderTransform>
								<MatrixTransform Matrix="{app:CenterOffsetTransform}" />
							</Grid.RenderTransform>
							<!-- Background -->
							<Ellipse Width="34" Height="34"
							         Fill="{StaticResource Brush.MapIconBackground}"
							         IsHitTestVisible="False"
							         Visibility="{Binding MainIcon, Converter={StaticResource NotEqualsToVis}, ConverterParameter='None'}" />
							<!-- Hover -->
							<Ellipse x:Name="HoverEllipse"
							         Width="53" Height="53"
							         app:VirtualCursor.SupportsIsCursorOver="{Binding IsSelectable}">
								<Ellipse.Style>
									<Style TargetType="Ellipse">
										<Setter Property="Fill" Value="Transparent" />
										<Style.Triggers>
											<Trigger Property="app:VirtualCursor.IsCursorOver" Value="True">
												<Setter Property="Fill" Value="{StaticResource Brush.Insignia_White}" />
											</Trigger>
										</Style.Triggers>
									</Style>
								</Ellipse.Style>
							</Ellipse>
							<!-- Common Circle -->
							<Ellipse x:Name="Circle"
							         Width="42" Height="42"
							         StrokeThickness="4"
							         Stroke="{TemplateBinding app:Brushes.Stroke}"
							         IsHitTestVisible="False"
							         noesis:Element.PPAAIn="0.6"
							         noesis:Element.PPAAOut="0.6" />
							<!-- Second Circle for Mandatory -->
							<Ellipse Width="54" Height="54"
							         StrokeThickness="4"
							         Stroke="{TemplateBinding app:Brushes.Stroke}"
							         IsHitTestVisible="False"
							         noesis:Element.PPAAIn="0.6"
							         noesis:Element.PPAAOut="0.6"
							         Visibility="{Binding IsMandatory, Converter={StaticResource BoolToVis}}" />
							<!-- Mission Type -->
							<Viewbox Width="42" Height="42">
								<Grid IsHitTestVisible="False">
									<Control Width="42" Height="42"
									         Background="{StaticResource Brush.Transparent}"
									         Template="{Binding MainIcon, Converter={StaticResource Career.Icon_MissionType}}" />
									<Control HorizontalAlignment="Center"
									         VerticalAlignment="Top"
									         Margin="0,-15,0,0"
									         Foreground="{StaticResource Brush.Black_Gray}"
									         Template="{Binding StatusIcon, Converter={StaticResource Career.Icon_MapMissionStatus}}" />
									<Control Template="{StaticResource Vector.Career_NightMission}"
											 Visibility="{Binding IsNightMission, Converter={StaticResource BoolToVis}}"
											 HorizontalAlignment="Center"
									         VerticalAlignment="Bottom"
									         Margin="0,0,0,-8"/>
								</Grid>
							</Viewbox>
						</Grid>
					</Grid>
					<ControlTemplate.Triggers>
						<MultiDataTrigger>
							<MultiDataTrigger.Conditions>
								<Condition Binding="{Binding IsRoutePoint}" Value="True" />
								<Condition Binding="{Binding IsRouteStart}" Value="False" />
								<Condition Binding="{Binding IsRouteTarget}" Value="False" />
							</MultiDataTrigger.Conditions>
							<Setter TargetName="Circle" Property="Width" Value="18" />
							<Setter TargetName="Circle" Property="Height" Value="18" />
							<Setter TargetName="HoverEllipse" Property="Width" Value="30" />
							<Setter TargetName="HoverEllipse" Property="Height" Value="30" />
						</MultiDataTrigger>
						<MultiDataTrigger>
							<MultiDataTrigger.Conditions>
								<Condition Binding="{Binding IsSelected}" Value="True" />
								<Condition Binding="{Binding IsRouteTarget}" Value="True" />
							</MultiDataTrigger.Conditions>
							<Setter TargetName="Circle" Property="StrokeThickness" Value="8" />
							<Setter TargetName="Circle" Property="Width" Value="46" />
							<Setter TargetName="Circle" Property="Height" Value="46" />
						</MultiDataTrigger>
						<MultiDataTrigger>
							<MultiDataTrigger.Conditions>
								<Condition Binding="{Binding IsSelected}" Value="True" />
								<Condition Binding="{Binding IsRoutePoint}" Value="True" />
								<Condition Binding="{Binding IsRouteStart}" Value="False" />
								<Condition Binding="{Binding IsRouteTarget}" Value="False" />
							</MultiDataTrigger.Conditions>
							<Setter TargetName="Circle" Property="StrokeThickness" Value="8" />
							<Setter TargetName="Circle" Property="Width" Value="22" />
							<Setter TargetName="Circle" Property="Height" Value="22" />
						</MultiDataTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<DataTrigger Binding="{Binding IsRoutePoint}" Value="True">
