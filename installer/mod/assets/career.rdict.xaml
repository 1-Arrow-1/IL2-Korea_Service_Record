<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="d"
                    xmlns:app="clr-namespace:WPFDesign"
                    xmlns:career="clr-namespace:WPFDesign.Controls.Career"
                    xmlns:com="clr-namespace:WPFDesign.Controls.Common"
                    xmlns:hangar="clr-namespace:WPFDesign.Controls.Hangar"
                    xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"
                    xmlns:weather="clr-namespace:WPFDesign.Controls.Career.Weather">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/WPFDesign;component/Assets/Images/Ranks.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<Style x:Key="Style.FlatButton_Career_UnitGroup" TargetType="com:FlatButton"
	       BasedOn="{StaticResource Style.FlatButton_Simple}">
		<Setter Property="HoverBackground" Value="{StaticResource Brush.Hover_White}" />
	</Style>

	<Style x:Key="Style.SqdManagement_SubHeader" TargetType="TextBlock">
		<Setter Property="FontFamily" Value="{StaticResource Font.Inter}" />
		<Setter Property="FontStyle" Value="Normal" />
		<Setter Property="FontWeight" Value="Normal" />
		<Setter Property="FontSize" Value="20" />
		<Setter Property="Foreground" Value="{StaticResource Brush.Olive_Drab}" />
	</Style>

	<Style x:Key="Style.Shape_OliveDrab_1px" TargetType="Shape">
		<Setter Property="Stroke" Value="{app:BrushOffset {StaticResource NoiseBrush.Olive_Drab}}" />
		<Setter Property="StrokeThickness" Value="{app:RoundToPixels 1}" />
	</Style>
	<Style x:Key="Style.Shape_OliveDrab_2px" TargetType="Shape">
		<Setter Property="Stroke" Value="{app:BrushOffset {StaticResource NoiseBrush.Olive_Drab}}" />
		<Setter Property="StrokeThickness" Value="{app:RoundToPixels 2}" />
	</Style>
	<Style x:Key="Style.Shape_OliveDrab_4px" TargetType="Shape">
		<Setter Property="Stroke" Value="{StaticResource Brush.Olive_Drab}" />
		<Setter Property="StrokeThickness" Value="{app:RoundToPixels 4}" />
	</Style>

	<Style x:Key="Style.Shape_OliveDrab_4px_Stretch" TargetType="Shape">
		<Setter Property="Stroke" Value="{StaticResource Brush.Olive_Drab}" />
		<Setter Property="StrokeThickness" Value="{app:RoundToPixels 4}" />
		<Setter Property="Stretch" Value="Fill" />
	</Style>

	<Style x:Key="Style.Shape_SeaBlue_4px_Stretch" TargetType="Shape">
		<Setter Property="Stroke" Value="{app:BrushOffset {StaticResource NoiseBrush.Sea_Blue}}" />
		<Setter Property="StrokeThickness" Value="{app:RoundToPixels 4}" />
		<Setter Property="Stretch" Value="Fill" />
	</Style>

	<!-- Заголовок в виджете погоды -->
	<Style x:Key="Style.Weather.Widget.Item.Header" TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
		<Setter Property="FontSize" Value="12" />
		<Setter Property="FontFamily" Value="{StaticResource Font.Geologica}" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Foreground" Value="#9A958B" />
		<Setter Property="app:Text.IsUpperCase" Value="True" />
		<Setter Property="noesis:Text.CharacterSpacing" Value="30" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="HorizontalAlignment" Value="Left" />
	</Style>

	<!-- Выбранное строковое значение в виджете погоды -->
	<Style x:Key="Style.Weather.Widget.Item.StringValue" TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
		<Setter Property="FontSize" Value="14" />
		<Setter Property="FontFamily" Value="{StaticResource Font.Inter}" />
		<Setter Property="FontWeight" Value="Medium" />
		<Setter Property="Foreground" Value="{StaticResource Brush.Olive_Drab}" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="HorizontalAlignment" Value="Left" />
	</Style>

	<!-- Выбранное значение в виджете погоды -->
	<Style x:Key="Style.WidgetWeatherItem_Value" TargetType="TextBlock">
		<Setter Property="FontFamily" Value="{StaticResource Font.Inter}" />
		<Setter Property="FontStyle" Value="Normal" />
		<Setter Property="VerticalAlignment" Value="Bottom" />
		<Setter Property="TextAlignment" Value="Center" />
		<Setter Property="Margin" Value="-14,0,-14,1" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="Foreground" Value="{StaticResource NoiseBrush.Olive_Drab}" />
	</Style>

	<ControlTemplate x:Key="Template.Career_RouteSliderThumb" TargetType="Thumb">
		<Canvas Width="0" Height="18">
			<Border x:Name="Thumb"
			        Canvas.Left="-2.5"
			        Width="5" Height="18"
			        Background="{StaticResource Brush.Orange_Yellow}"
			        Visibility="Hidden" />
		</Canvas>
		<ControlTemplate.Triggers>
			<DataTrigger Value="True">
				<DataTrigger.Binding>
					<MultiBinding Converter="{StaticResource BooleanExpr}" ConverterParameter="{app:BooleanExpression '0*1+2*!1'}">
						<Binding Path="IsMouseOver" RelativeSource="{RelativeSource AncestorType={x:Type Slider}}" />
						<Binding Path="IsMouseNavigation" RelativeSource="{RelativeSource AncestorType={x:Type Window}}" />
						<Binding Path="IsKeyboardFocused" RelativeSource="{RelativeSource AncestorType={x:Type Slider}}" />
					</MultiBinding>
				</DataTrigger.Binding>
				<Setter TargetName="Thumb" Property="Visibility" Value="Visible" />
			</DataTrigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>

	<ControlTemplate x:Key="Template.Career_RouteSliderButton" TargetType="ButtonBase">
		<Grid x:Name="TemplateRoot" Background="Transparent">
			<Border Height="6" Background="{TemplateBinding Background}" />
		</Grid>
	</ControlTemplate>

	<ControlTemplate x:Key="Template.Career_RouteSlider" TargetType="com:SliderEx">
		<Grid x:Name="TemplateRoot">
			<Track x:Name="PART_Track" Orientation="Horizontal">
				<Track.DecreaseRepeatButton>
					<RepeatButton Background="{TemplateBinding Foreground}"
					              Focusable="False"
					              Template="{StaticResource Template.Career_RouteSliderButton}" />
				</Track.DecreaseRepeatButton>
				<Track.IncreaseRepeatButton>
					<RepeatButton Background="{TemplateBinding Background}"
					              Focusable="False"
					              Template="{StaticResource Template.Career_RouteSliderButton}" />
				</Track.IncreaseRepeatButton>
				<Track.Thumb>
					<Thumb Template="{StaticResource Template.Career_RouteSliderThumb}" />
				</Track.Thumb>
			</Track>
		</Grid>
	</ControlTemplate>

	<ControlTemplate x:Key="Template.Career_MissionStartTimeSlider" TargetType="com:SliderEx">
		<!-- Без MinWidht/Height есть странный сдвиг кнопок при наведении мыши -->
		<Grid x:Name="TemplateRoot">

			<Border Height="6"
			        VerticalAlignment="Center"
			        Background="{TemplateBinding app:Brushes.Fill}"
			        Visibility="{Binding IsEnabled, ElementName=TemplateRoot, Converter={StaticResource BoolToVis}}">
				<Canvas>
					<Border x:Name="PART_SelectionRange"
					        Height="6"
					        Background="{TemplateBinding Background}"
					        Visibility="Collapsed" />
					<Border x:Name="PART_SelectionRange2"
					        Height="6"
					        Background="{TemplateBinding Background}"
					        Visibility="Collapsed" />
				</Canvas>
			</Border>

			<Track x:Name="PART_Track" Orientation="Horizontal">
				<Track.DecreaseRepeatButton>
					<RepeatButton Background="{x:Null}"
					              Focusable="False"
					              Template="{StaticResource Template.Career_RouteSliderButton}" />
				</Track.DecreaseRepeatButton>
				<Track.IncreaseRepeatButton>
					<RepeatButton Background="{x:Null}"
					              Focusable="False"
					              Template="{StaticResource Template.Career_RouteSliderButton}" />
				</Track.IncreaseRepeatButton>
				<Track.Thumb>
					<Thumb Template="{StaticResource Template.Career_RouteSliderThumb}" />
				</Track.Thumb>
			</Track>
		</Grid>
		<ControlTemplate.Triggers>
			<Trigger Property="IsSelectionRangeEnabled" Value="True">
				<Setter TargetName="PART_SelectionRange" Property="Visibility" Value="Visible" />
			</Trigger>
			<Trigger Property="IsSelectionRange2Enabled" Value="True">
				<Setter TargetName="PART_SelectionRange2" Property="Visibility" Value="Visible" />
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>

	<Style x:Key="Style.Career_RouteSlider" TargetType="com:SliderEx">
		<Setter Property="IsMoveToPointEnabled" Value="True" />
		<Setter Property="IsSnapToTickEnabled" Value="True" />
		<Setter Property="IsSelectionRangeEnabled" Value="False" />
		<Setter Property="Orientation" Value="Horizontal" />
		<Setter Property="Template" Value="{StaticResource Template.Career_RouteSlider}" />
		<Setter Property="app:Focus.VisualStyle" Value="{x:Null}" />
		<Setter Property="Focusable" Value="True" />
		<Setter Property="Height" Value="26" />
		<Setter Property="app:Focus.AutoExitDown" Value="True" />
		<Setter Property="app:Focus.AutoExitUp" Value="True" />
		<Setter Property="app:Focus.IsFocusEngagementEnabled" Value="False" />
		<Setter Property="Background" Value="{StaticResource Brush.Button_Gray}" />
		<Setter Property="Foreground" Value="{StaticResource Brush.Lite_Olive_Drab}" />
	</Style>
	<Style x:Key="Style.Career_WidgetSlider" TargetType="com:SliderEx" BasedOn="{StaticResource Style.Career_RouteSlider}">
		<Setter Property="Background" Value="{StaticResource Brush.Lite_Olive_Drab}" />
		<Setter Property="Foreground" Value="{StaticResource Brush.Button_Gray}" />
		<Setter Property="app:Brushes.Fill" Value="{StaticResource Brush.Dark_Olive_Drab}" />
	</Style>

	<DataTemplate x:Key="DataTemplate.TacticalCodes">
		<ItemsControl Focusable="False" ItemsSource="{Binding Characters}">
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<StackPanel Orientation="Horizontal" Margin="0,0,-4,0" />
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>
			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<Rectangle Width="60" Height="60"
					           Margin="{Binding IsFollowedByGap, Converter={app:IfTrue '0,0,10,0', Else=0}}">
						<Rectangle.Fill>
							<ImageBrush ImageSource="{Binding Image}"
							            noesis:Brush.Shader="{Binding ColorIndex, Converter={StaticResource Shaders.TacticalCodes}}" />
						</Rectangle.Fill>
					</Rectangle>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
			<ItemsControl.Template>
				<ControlTemplate TargetType="{x:Type ItemsControl}">
					<Viewbox Stretch="Uniform">
						<ItemsPresenter />
					</Viewbox>
				</ControlTemplate>
			</ItemsControl.Template>
		</ItemsControl>
	</DataTemplate>

	<ControlTemplate x:Key="Template.Career_UnitGroup_Header_Static">
		<Grid Margin="-1" IsHitTestVisible="False">
			<Path
				Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource AddConverter}, ConverterParameter=-12}"
				VerticalAlignment="Top"
				Stretch="Fill"
				Data="M0,16 v-16 h10 v16"
				noesis:Element.PPAAMode="Disabled"
				Style="{StaticResource Style.Shape_OliveDrab_2px}"
				d:Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}" />
			<TextBlock VerticalAlignment="Center"
			           Margin="24,0"
			           Foreground="{StaticResource Brush.Olive_Drab}"
			           TextAlignment="Center"
			           TextWrapping="Wrap"
			           Style="{StaticResource Style.ARM_Title_Small_1}"
			           Text="{Binding DisplayName}"
			           d:Text="Unit" />
		</Grid>
	</ControlTemplate>

	<ControlTemplate x:Key="Template.Career_UnitGroup_Header_Selectable">
		<Grid Margin="-1">
			<com:FlatButton Margin="1"
			                Style="{StaticResource Style.FlatButton_Career_UnitGroup}"
			                Command="{Binding DataContext.ToggleSelection, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}"
			                CommandParameter="{Binding}"
			                HoverCommand="{Binding DataContext.SetHighlight, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}"
			                HoverLostCommand="{Binding DataContext.ClearHighlight, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}" />
			<Path VerticalAlignment="Top"
			      Stretch="Fill"
			      Data="M0,16 v-16 h1000 v16"
			      IsHitTestVisible="False"
			      noesis:Element.PPAAMode="Disabled"
			      Style="{StaticResource Style.Shape_OliveDrab_2px}" />
			<TextBlock VerticalAlignment="Center"
			           Margin="24,0"
			           Foreground="{StaticResource Brush.Olive_Drab}"
			           IsHitTestVisible="False"
			           TextAlignment="Center"
			           TextWrapping="Wrap"
			           Style="{StaticResource Style.ARM_Title_Small_1}"
			           Text="{Binding DisplayName}"
			           d:Text="Unit" />
		</Grid>
	</ControlTemplate>

	<DataTemplate x:Key="DataTemplate.Career_UnitGroup_Header_Row">
		<ItemsControl x:Name="ItemsControl"
		              VerticalAlignment="Top"
		              Focusable="False"
		              d:Height="32" d:Width="888"
		              ItemsSource="{Binding Items}">
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<com:AutoGrid Columns="{Binding Columns}"
					              ColumnWidth="74"
					              Rows="{Binding Rows}"
					              RowHeight="32" />
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>
			<ItemsControl.ItemContainerStyle>
				<Style TargetType="ContentPresenter">
					<Setter Property="Grid.Column" Value="{Binding Column}" />
					<Setter Property="Grid.Row" Value="{Binding Row}" />
					<Setter Property="Grid.ColumnSpan" Value="{Binding ColumnSpan}" />
					<Setter Property="Grid.RowSpan" Value="{Binding RowSpan}" />
				</Style>
			</ItemsControl.ItemContainerStyle>
			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<Control x:Name="Item" Template="{StaticResource Template.Career_UnitGroup_Header_Static}" />
					<DataTemplate.Triggers>
						<DataTrigger Binding="{Binding IsSelectable}" Value="True">
							<Setter TargetName="Item" Property="Template"
							        Value="{StaticResource Template.Career_UnitGroup_Header_Selectable}" />
						</DataTrigger>
					</DataTemplate.Triggers>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>
		<DataTemplate.Triggers>
			<DataTrigger Binding="{Binding LastItemFill}" Value="True">
				<Setter TargetName="ItemsControl" Property="ItemsPanel">
					<Setter.Value>
						<ItemsPanelTemplate>
							<com:AutoGrid Columns="{Binding Columns}"
							              ColumnWidth="74"
							              LastColumnWidth="1*"
							              Rows="{Binding Rows}"
							              RowHeight="32" />
						</ItemsPanelTemplate>
					</Setter.Value>
				</Setter>
			</DataTrigger>
		</DataTemplate.Triggers>
	</DataTemplate>

