	<PathGeometry x:Key="Geometry.Career_StatusIcon_Clip">
		<PathFigure IsClosed="True" IsFilled="True"
		            StartPoint="0,0">
			<LineSegment Point="50,0" />
			<LineSegment Point="50,28" />
			<LineSegment Point="28,28" />
			<LineSegment Point="28,50" />
			<LineSegment Point="0,50" />
		</PathFigure>
