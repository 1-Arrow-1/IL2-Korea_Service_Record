	<ControlTemplate x:Key="Vector.LostIcon">
		<Path Stretch="Uniform"
		      StrokeThickness="2"
		      Stroke="{StaticResource Brush.Dark_Olive_Drab}"
		      Data="M0,0 l50,50 M0,50 l50,-50" />
	</ControlTemplate>

	<ControlTemplate x:Key="Vector.LostRibbon">
		<Path x:Name="MourningRibbon"
		      HorizontalAlignment="Right"
		      VerticalAlignment="Bottom"
		      Stretch="Fill"
		      Data="M0,100 L100,0 L100,33 L33,100 Z">
			<Path.Fill>
				<LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
					<LinearGradientBrush.GradientStops>
						<GradientStopCollection>
							<GradientStop Offset="0.0" Color="#FF30312D" />
							<GradientStop Offset="0.18" Color="#FF1A1B18" />
							<GradientStop Offset="0.72" Color="#FF1A1B18" />
							<GradientStop Offset="1.0" Color="#FF25271F" />
						</GradientStopCollection>
					</LinearGradientBrush.GradientStops>
				</LinearGradientBrush>
			</Path.Fill>
		</Path>
	</ControlTemplate>

