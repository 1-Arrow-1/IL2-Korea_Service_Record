						<ItemsPanelTemplate>
							<DockPanel />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Border MinWidth="{Binding Columns, Converter={StaticResource MulConverter}, ConverterParameter=74}"
