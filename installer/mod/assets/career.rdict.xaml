						        VerticalAlignment="Center"
						        Padding="60"
						        Background="{StaticResource Brush.BG_solidgreen}">
							<StackPanel MinWidth="382">
								<Control Width="196"
								         Foreground="{StaticResource Brush.Insignia_White}"
								         Template="{app:ResourceByLocalize {StaticResource Vector.LocalizedLogoKoreaConverter}}"
