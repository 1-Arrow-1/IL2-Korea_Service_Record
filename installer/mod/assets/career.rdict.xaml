			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<Trigger Property="Tag" Value="{x:Null}">
				<Setter Property="ImageOffset" Value="0" />
				<Setter Property="ImageTemplate" Value="{x:Null}" />
