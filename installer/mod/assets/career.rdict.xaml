	<Style x:Key="Style.FlatButton.Career.ImproveQual" TargetType="com:FlatButton"
	       BasedOn="{StaticResource Style.FlatButton.Career}">
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="VerticalAlignment" Value="Bottom" />
		<Setter Property="ImageOffset" Value="10" />
		<Setter Property="ImageTemplate">
			<Setter.Value>
				<ControlTemplate>
					<Control Width="14" Height="14"
					         HorizontalAlignment="Center"
					         VerticalAlignment="Center"
					         Foreground="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=com:FlatButton}, Path=Foreground}"
					         Template="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=com:FlatButton}, Path=Tag}" />
