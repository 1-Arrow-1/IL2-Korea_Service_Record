					<Setter Property="VerticalContentAlignment" Value="Center" />
					<Setter Property="FocusVisualStyle" Value="{x:Null}" />
					<Setter Property="app:Focus.MouseFocus" Value="True" />
					<Setter Property="Template">
						<Setter.Value>
							<ControlTemplate TargetType="ListBoxItem">
								<Grid>
									<ContentControl x:Name="FocusControl"
									                Margin="0"
									                Template="{Binding (app:Extensions.Data), RelativeSource={RelativeSource AncestorType=ListBox}}"
									                Visibility="Hidden" />
									<ContentPresenter />
									<Canvas Width="36" Height="36">
										<Path x:Name="LineControl"
										      StrokeThickness="2"
										      Stroke="{StaticResource Brush.Ice_Blue}"
										      app:BrushOffset.TargetProperty="Line.Stroke"
										      Visibility="Collapsed" />
									</Canvas>
								</Grid>
								<ControlTemplate.Triggers>
									<DataTrigger Value="True">
										<DataTrigger.Binding>
											<MultiBinding Converter="{StaticResource BooleanExpr}"
											              ConverterParameter="{app:BooleanExpression '!0*(1*3+2*!3)'}">
												<Binding Path="IsSelected" RelativeSource="{RelativeSource Self}" />
												<Binding Path="IsMouseOver" RelativeSource="{RelativeSource Self}" />
												<Binding Path="IsKeyboardFocused" RelativeSource="{RelativeSource Self}" />
												<Binding Path="IsMouseNavigation" RelativeSource="{RelativeSource AncestorType=Window}" />
											</MultiBinding>
										</DataTrigger.Binding>
										<DataTrigger.EnterActions>
											<BeginStoryboard x:Name="startFlashing">
												<Storyboard>
													<ThicknessAnimation AutoReverse="True" RepeatBehavior="Forever"
													                    Storyboard.TargetName="FocusControl"
													                    Storyboard.TargetProperty="Margin"
													                    Duration="0:0:0.25"
													                    From="-2" To="0" />
												</Storyboard>
											</BeginStoryboard>
										</DataTrigger.EnterActions>
										<DataTrigger.ExitActions>
											<StopStoryboard BeginStoryboardName="startFlashing" />
										</DataTrigger.ExitActions>
										<Setter TargetName="FocusControl" Property="Visibility" Value="Visible" />
									</DataTrigger>
									<Trigger Property="IsSelected" Value="True">
										<Setter TargetName="FocusControl" Property="Visibility" Value="Visible" />
										<Setter TargetName="FocusControl" Property="Margin" Value="0" />
									</Trigger>
									<DataTrigger Binding="{Binding LineType}" Value="1">
										<Setter TargetName="LineControl" Property="Visibility" Value="Visible" />
										<Setter TargetName="LineControl" Property="Data" Value="M0,18h36" />
									</DataTrigger>
									<DataTrigger Binding="{Binding LineType}" Value="2">
										<Setter TargetName="LineControl" Property="Visibility" Value="Visible" />
										<Setter TargetName="LineControl" Property="Data" Value="M0,18h36m-8,-5l8,5l-8,5" />
									</DataTrigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</Setter.Value>
					</Setter>
					<Setter Property="Margin" Value="0" />
				</Style>
			</Setter.Value>
		</Setter>
		<Setter Property="Template">
			<Setter.Value>
