	<ControlTemplate x:Key="Vector.Career_PilotSilhouette">
		<Path StrokeThickness="2"
		      Stroke="{TemplateBinding Foreground}"
		      Fill="{TemplateBinding Foreground}"
		      Data="M10 10C12.2091 10 14 7.48528 14 5C14 2.51472 12.2091 1 10 1C7.79086 1 6 2.51472 6 5C6 7.48528 7.79086 10 10 10Z M19 19C19 15 17.875 12 10 12C2.125 12 1 15 1 19" />
