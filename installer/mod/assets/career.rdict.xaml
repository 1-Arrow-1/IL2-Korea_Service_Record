		<Path StrokeLineJoin="Bevel"
		      Data="M0.5,0.5 h10 m4,0 h21 m4,0 h10 v10 m0,4 v21 m0,4 v10 h-10 m-4,0 h-21 m-4,0 h-10 v-10 m0,-4 v-21 m0,-4 v-10 z"
		      noesis:Element.PPAAMode="Disabled"
		      Style="{StaticResource Style.Shape_OliveDrab_1px}" />
	</ControlTemplate>

