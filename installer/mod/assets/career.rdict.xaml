	<ControlTemplate x:Key="Template.Career_Unit_PlaneImage" TargetType="Control">
		<Grid Height="50">

			<Grid x:Name="ActualPlane">

				<Control x:Name="PlaneIcon"
				         app:Brushes.Fill="{app:BrushOffset {StaticResource NoiseBrush.Olive_Drab}}"
				         app:Brushes.Geometry="{Binding IconName, Converter={StaticResource Geometry.PlaneIconsConverter}}"
				         Template="{StaticResource Vector.Career_PlaneIcon}" />

				<Control x:Name="StatusOverlay"
				         Template="{StaticResource Vector.Lines.Diagonals}"
				         Visibility="Collapsed" />

				<Control x:Name="StatusIcon"
				         Width="20" Height="20"
				         HorizontalAlignment="Right"
				         VerticalAlignment="Bottom"
				         Template="{Binding Status, Converter={StaticResource Career.StatusIcons_Plane}, FallbackValue={x:Null}}"
				         Visibility="Collapsed" />

			</Grid>

			<Control x:Name="PlanePlaceholder"
			         app:Brushes.Geometry="{Binding IconName, Converter={StaticResource Geometry.PlaneIconsConverter}}"
			         app:Brushes.Stroke="{StaticResource Brush.Olive_Drab}"
			         Template="{StaticResource Vector.Career_PlaneIcon}"
			         Visibility="Collapsed" />

		</Grid>
		<ControlTemplate.Triggers>
			<DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
				<Setter TargetName="ActualPlane" Property="Visibility" Value="Collapsed" />
				<Setter TargetName="PlanePlaceholder" Property="Visibility" Value="Visible" />
			</DataTrigger>
			<DataTrigger Binding="{Binding HasStatusIcon, FallbackValue=False}" Value="True">
				<Setter TargetName="PlaneIcon" Property="Clip" Value="{StaticResource Geometry.Career_StatusIcon_Clip}" />
				<Setter TargetName="StatusIcon" Property="Visibility" Value="Visible" />
			</DataTrigger>
			<DataTrigger Binding="{Binding Status}" Value="{x:Static app:PlaneStatus.Damaged}">
				<Setter TargetName="PlaneIcon" Property="app:Brushes.Fill"
				        Value="{app:BrushOffset {StaticResource NoiseBrush.Insignia_Red}}" />
			</DataTrigger>
			<DataTrigger Binding="{Binding Status}" Value="{x:Static app:PlaneStatus.Returning}">
				<Setter TargetName="PlaneIcon" Property="Opacity" Value="0.5" />
				<Setter TargetName="StatusOverlay" Property="Visibility" Value="Visible" />
			</DataTrigger>
			<DataTrigger Binding="{Binding Status}" Value="{x:Static app:PlaneStatus.Lost}">
				<Setter TargetName="StatusOverlay" Property="Template" Value="{StaticResource Vector.LostIcon}" />
				<Setter TargetName="StatusOverlay" Property="Visibility" Value="Visible" />
			</DataTrigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>

	<ControlTemplate x:Key="Template.Career_Unit_PilotImage" TargetType="Control">
		<Grid Height="50">

			<Grid x:Name="ActualPilot">

				<Image x:Name="PilotPhoto"
				       Source="{Binding Photo, Converter={StaticResource UriFormat}, ConverterParameter='{}/Assets/PilotPhotos/{0}.dds'}"
				       Opacity="{Binding IsReadyForMission, Converter={app:IfTrue 1.0, Else=0.5}}"
				       noesis:Element.PPAAMode="Disabled"
				       d:Source="{StaticResource Menu.TestImage}" />

				<Control x:Name="StatusOverlay"
				         Template="{StaticResource Vector.Lines.Diagonals}"
				         Visibility="Collapsed" />

				<Control x:Name="StatusIcon"
				         Width="20" Height="20"
				         HorizontalAlignment="Right"
				         VerticalAlignment="Bottom"
				         Template="{Binding Status, Converter={StaticResource Career.StatusIcons_Pilot}, FallbackValue={x:Null}}"
				         Visibility="Collapsed" />
			</Grid>

			<Control x:Name="PilotPlaceholder"
			         Template="{StaticResource Vector.Career_Photo_Placeholder}"
			         Visibility="Collapsed" />

		</Grid>
		<ControlTemplate.Triggers>
			<DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
				<Setter TargetName="ActualPilot" Property="Visibility" Value="Collapsed" />
				<Setter TargetName="PilotPlaceholder" Property="Visibility" Value="Visible" />
			</DataTrigger>
			<DataTrigger Binding="{Binding HasStatusIcon, FallbackValue=False}" Value="True">
				<Setter TargetName="PilotPhoto" Property="Clip" Value="{StaticResource Geometry.Career_StatusIcon_Clip}" />
				<Setter TargetName="StatusIcon" Property="Visibility" Value="Visible" />
				<Setter TargetName="StatusOverlay" Property="Visibility" Value="Visible" />
			</DataTrigger>
			<MultiDataTrigger>
				<MultiDataTrigger.Conditions>
					<Condition Binding="{Binding HasStatusIcon}" Value="False" />
					<Condition Binding="{Binding IsPlayer}" Value="True" />
				</MultiDataTrigger.Conditions>
				<Setter TargetName="PilotPhoto" Property="Clip" Value="{StaticResource Geometry.Career_StatusIcon_Clip}" />
				<Setter TargetName="StatusIcon" Property="Visibility" Value="Visible" />
				<Setter TargetName="StatusIcon" Property="Template" Value="{StaticResource Vector.Career_CommanderPilotIcon}" />
				<Setter TargetName="StatusIcon" Property="Background" Value="{StaticResource Brush.Orange_Yellow}" />
				<Setter TargetName="StatusIcon" Property="Foreground" Value="{StaticResource Brush.Insignia_White}" />
			</MultiDataTrigger>
			<DataTrigger Binding="{Binding IsLost, FallbackValue=False}" Value="True">
				<Setter TargetName="StatusOverlay" Property="Template" Value="{StaticResource Vector.LostIcon}" />
				<Setter TargetName="StatusOverlay" Property="Visibility" Value="Visible" />
			</DataTrigger>
			<DataTrigger Binding="{Binding IsLeadPilot, FallbackValue=False}" Value="True">
				<Setter TargetName="PilotPhoto" Property="Clip" Value="{StaticResource Geometry.Career_StatusIcon_Clip}" />
				<Setter TargetName="StatusIcon" Property="Visibility" Value="Visible" />
				<Setter TargetName="StatusIcon" Property="Template" Value="{StaticResource Vector.Career_CommanderPilotIcon}" />
				<Setter TargetName="StatusIcon" Property="Background" Value="{StaticResource Brush.Deep_Purple}" />
				<Setter TargetName="StatusIcon" Property="Foreground" Value="{StaticResource Brush.Insignia_White}" />
			</DataTrigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>

