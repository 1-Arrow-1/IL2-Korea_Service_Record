	<Style x:Key="Style.Control.AwardInfoLabels" TargetType="Control">
		<Style.Resources>
			<Style x:Key="Style.BulletDecorator" TargetType="ContentControl">
				<Setter Property="Focusable" Value="False" />
				<Setter Property="Foreground" Value="{StaticResource Brush.Light_Green}" />
				<Setter Property="ContentTemplate">
					<Setter.Value>
						<DataTemplate>
							<TextBlock Text="{Binding}"
							           Style="{StaticResource Style.QM_Small_Title}" />
						</DataTemplate>
					</Setter.Value>
				</Setter>
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="ContentControl">
							<BulletDecorator>
								<BulletDecorator.Child>
									<ContentPresenter Margin="10 0 0 0" />
								</BulletDecorator.Child>
								<BulletDecorator.Bullet>
									<Ellipse Fill="{TemplateBinding Foreground}" Width="8" Height="8" />
								</BulletDecorator.Bullet>
							</BulletDecorator>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
		</Style.Resources>
		<Setter Property="Focusable" Value="False" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Control">
					<StackPanel Orientation="Vertical">
						<ContentControl Style="{StaticResource Style.BulletDecorator}"
						                Content="{app:Localize carDossier_AwardAvailable}"
						                Visibility="{Binding IsAwardAvailable, Converter={StaticResource BoolToVis}}" />
						<Decorator Height="5">
							<Decorator.Style>
								<Style TargetType="Decorator">
									<Setter Property="Visibility" Value="Collapsed" />
									<Style.Triggers>
										<MultiDataTrigger>
											<MultiDataTrigger.Conditions>
												<Condition Binding="{Binding IsAwardAvailable}" Value="True" />
												<Condition Binding="{Binding IsPromotionAvailable}" Value="True" />
											</MultiDataTrigger.Conditions>
											<Setter Property="Visibility" Value="Visible" />
										</MultiDataTrigger>
									</Style.Triggers>
								</Style>
							</Decorator.Style>
						</Decorator>
						<ContentControl Style="{StaticResource Style.BulletDecorator}"
						                Content="{app:Localize carDossier_PromotionAvailable}"
						                Visibility="{Binding IsPromotionAvailable, Converter={StaticResource BoolToVis}}" />
					</StackPanel>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Setter Property="Visibility" Value="Collapsed" />
		<Style.Triggers>
			<DataTrigger Binding="{Binding IsAwardAvailable}" Value="True">
				<Setter Property="Visibility" Value="Visible" />
			</DataTrigger>
			<DataTrigger Binding="{Binding IsPromotionAvailable}" Value="True">
				<Setter Property="Visibility" Value="Visible" />
			</DataTrigger>
		</Style.Triggers>
	</Style>

	<ControlTemplate x:Key="ControlTemplate.Overlay.Diagonal" TargetType="ContentControl">
		<Grid ClipToBounds="True">
			<com:FixedItemsControl Margin="-100"
			                       RenderTransformOrigin="0.5, 0.5"
			                       ItemCount="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content, FallbackValue=0}">
				<com:FixedItemsControl.RenderTransform>
					<RotateTransform Angle="135" />
				</com:FixedItemsControl.RenderTransform>
				<com:FixedItemsControl.ItemTemplate>
					<DataTemplate>
						<StackPanel Orientation="Vertical">
							<Line StrokeThickness="16"
							      Stroke="{StaticResource Brush.Insignia_White}"
							      X1="0" X2="700" />
							<Decorator Height="8" />
						</StackPanel>
					</DataTemplate>
				</com:FixedItemsControl.ItemTemplate>
			</com:FixedItemsControl>
		</Grid>
	</ControlTemplate>

</ResourceDictionary>
