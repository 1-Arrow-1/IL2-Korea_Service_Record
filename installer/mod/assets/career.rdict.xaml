	<Style x:Key="Style.MissionIssueMessage" TargetType="ContentControl">
		<Setter Property="Focusable" Value="False" />
		<Setter Property="Visibility" Value="Collapsed" />
		<Setter Property="IsHitTestVisible" Value="False" />
		<Setter Property="MinHeight" Value="50" />
		<Setter Property="Background" Value="{StaticResource Brush.International_Orange}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ContentControl">
					<DockPanel>
						<Border DockPanel.Dock="Top"
						        Height="2"
						        Background="{StaticResource Brush.Dark_Green}" />
						<Border Background="{TemplateBinding Background}">
							<DockPanel HorizontalAlignment="Left"
							           VerticalAlignment="Center"
							           Margin="20,0">
								<Control DockPanel.Dock="Left"
								         VerticalAlignment="Center"
								         Margin="0,0,10,0"
								         Foreground="{StaticResource Brush.Insignia_White}"
								         Template="{StaticResource Career.Icon_MissionIssues}" />
								<TextBlock Foreground="{StaticResource Brush.Insignia_White}"
								           TextWrapping="Wrap"
								           Style="{StaticResource Style.ARM_List_Text}"
								           d:Text="Issue"
								           app:Text.RichText="{TemplateBinding Content}" />
							</DockPanel>
						</Border>
					</DockPanel>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<DataTrigger Value="True">
				<DataTrigger.Binding>
					<MultiBinding Converter="{StaticResource HasFlagsMulti}">
						<Binding Path="(app:Extensions.Data)" RelativeSource="{RelativeSource Self}" />
						<Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
					</MultiBinding>
				</DataTrigger.Binding>
				<DataTrigger.EnterActions>
					<BeginStoryboard>
						<Storyboard>
							<DoubleAnimation Storyboard.TargetProperty="Opacity"
							                 Duration="{StaticResource Duration.ShortAnimation}"
							                 From="0" To="1" />
							<DoubleAnimation Storyboard.TargetProperty="Height"
							                 Duration="{StaticResource Duration.ShortAnimation}"
							                 From="0" To="50" />
							<ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
								<DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
							</ObjectAnimationUsingKeyFrames>
						</Storyboard>
					</BeginStoryboard>
				</DataTrigger.EnterActions>
				<DataTrigger.ExitActions>
					<BeginStoryboard>
						<Storyboard>
							<DoubleAnimation Storyboard.TargetProperty="Opacity"
							                 Duration="{StaticResource Duration.MediumAnimation}"
							                 To="0" />
							<DoubleAnimation Storyboard.TargetProperty="Height"
							                 Duration="{StaticResource Duration.MediumAnimation}"
							                 To="0" />
							<ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
								<DiscreteObjectKeyFrame KeyTime="{StaticResource KeyTime.MediumAnimationEnd}"
								                        Value="{x:Static Visibility.Collapsed}" />
							</ObjectAnimationUsingKeyFrames>
						</Storyboard>
					</BeginStoryboard>
				</DataTrigger.ExitActions>
			</DataTrigger>
		</Style.Triggers>
	</Style>

	<Style x:Key="Style.ContentControl.PilotState" TargetType="ContentControl">
		<Setter Property="Focusable" Value="False" />
		<Setter Property="Content" Value="{Binding}" />
		<Setter Property="Foreground" Value="{StaticResource Brush.Insignia_White}" />
		<Setter Property="ContentTemplate">
			<Setter.Value>
				<DataTemplate>
					<Border x:Name="StatusBorder" Background="{StaticResource Brush.Extra_Dark}"
					        Padding="10 0">
						<StackPanel HorizontalAlignment="Center"
						            VerticalAlignment="Center"
						            Orientation="Horizontal">
							<ContentControl x:Name="StatusIcon"
							                Width="22" Height="22"
							                Background="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Border}, Path=Background}"
							                Foreground="{StaticResource Brush.Insignia_White}"
							                Template="{StaticResource Icon.PilotDossier.State.Lost}" />
							<Decorator Width="10" />
							<TextBlock x:Name="StatusText"
							           VerticalAlignment="Center"
							           Foreground="{StaticResource Brush.Insignia_White}"
							           Style="{StaticResource Style.ARM_List_Text2}"
							           Text="{app:Localize carDossier_State_Pilot_Lost}" />
						</StackPanel>
					</Border>
					<DataTemplate.Triggers>
						<DataTrigger Binding="{Binding Status}" Value="{x:Static app:PilotStatus.WIA}">
							<Setter TargetName="StatusBorder" Property="Background" Value="{StaticResource Brush.Insignia_Red}" />
							<Setter TargetName="StatusIcon" Property="Template" Value="{StaticResource Icon.PilotDossier.State.Progress}" />
							<Setter TargetName="StatusIcon" Property="Content" Value="{Binding StatusProgress}" />
							<Setter TargetName="StatusText" Property="Text"
							        Value="{app:NumberFormat Binding={Binding StatusDays}, Units=Days, ZeroTextKey='carLessThanDay', StringFormatKey='carDossier_State_Pilot_Hospital'}" />
						</DataTrigger>
						<DataTrigger Binding="{Binding Status}" Value="{x:Static app:PilotStatus.Returning}">
							<Setter TargetName="StatusBorder" Property="Background" Value="{StaticResource Brush.Orange_Yellow}" />
							<Setter TargetName="StatusIcon" Property="Template" Value="{StaticResource Icon.PilotDossier.State.Progress}" />
							<Setter TargetName="StatusIcon" Property="Content" Value="{Binding StatusProgress}" />
							<Setter TargetName="StatusText" Property="Text"
							        Value="{app:NumberFormat Binding={Binding StatusDays}, Units=Days, ZeroTextKey='carLessThanDay', StringFormatKey='carDossier_State_Pilot_Returning'}" />
						</DataTrigger>
						<DataTrigger Binding="{Binding Status}" Value="{x:Static app:PilotStatus.Discharged}">
							<Setter TargetName="StatusText" Property="Text" Value="{app:Localize carDossier_State_Pilot_Discharged}" />
						</DataTrigger>
						<DataTrigger Binding="{Binding Status}" Value="{x:Static app:PilotStatus.Ready}">
							<Setter TargetName="StatusBorder" Property="Background" Value="{StaticResource Brush.Field_Green}" />
							<Setter TargetName="StatusIcon" Property="Template" Value="{StaticResource Icon.PilotDossier.State.Ready}" />
							<Setter TargetName="StatusText" Property="Text" Value="{app:Localize carDossier_State_Pilot_Ready}" />
						</DataTrigger>
					</DataTemplate.Triggers>
				</DataTemplate>
			</Setter.Value>
		</Setter>
	</Style>

