	<Style x:Key="Style.Weather.Widget.Item" TargetType="weather:WeatherPropertyItemControl">
		<Setter Property="Focusable" Value="False" />
		<Setter Property="Margin" Value="7,0" />
		<Setter Property="Height" Value="66" />
		<Setter Property="Width" Value="48" />
		<Setter Property="Padding" Value="8" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="weather:WeatherPropertyItemControl">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="48" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>

						<Border Grid.Column="0"
						        Padding="{TemplateBinding Padding}"
						        BorderThickness="2.5"
						        BorderBrush="{StaticResource NoiseBrush.Dark_Olive_Drab}"
						        app:BrushOffset.TargetProperty="Border.BorderBrush">
							<Control HorizontalAlignment="Center"
							         VerticalAlignment="Center"
							         HorizontalContentAlignment="Center"
							         VerticalContentAlignment="Center"
							         Foreground="{StaticResource NoiseBrush.Sea_Blue}"
							         noesis:Element.PPAAIn="0.5"
							         noesis:Element.PPAAOut="0.5"
							         Template="{TemplateBinding Icon}"
							         app:BrushOffset.TargetProperty="Control.Foreground" />
						</Border>

						<TextBlock Grid.Row="1"
						           Style="{StaticResource Style.WidgetWeatherItem_Value}"
						           Text="{TemplateBinding Value}" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="WeatherTimelapseProgressStyle" TargetType="ProgressBar">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Minimum" Value="0" />
		<Setter Property="Maximum" Value="1" />
		<Setter Property="Foreground" Value="{StaticResource NoiseBrush.Dark_Olive_Drab}" />
		<Setter Property="app:BrushOffset.TargetProperty" Value="ProgressBar.Foreground" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ProgressBar">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="*" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>

						<Grid Grid.Row="0" VerticalAlignment="Bottom">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="1*" />
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="3*" />
							</Grid.ColumnDefinitions>
						</Grid>

						<Grid Grid.Row="0" VerticalAlignment="Bottom">
							<Border x:Name="PART_Track" HorizontalAlignment="Center">
								<Line StrokeThickness="2"
								      Stroke="{TemplateBinding Foreground}"
								      StrokeDashArray="2 3"
								      X1="0"
								      X2="{TemplateBinding ActualWidth}" />
							</Border>

							<Border x:Name="PART_Indicator"
							        Height="2"
							        HorizontalAlignment="Left"
							        Margin="0,-1,0,1"
							        Background="{StaticResource Brush.Dark_Olive_Drab}">

								<Grid Width="90" Height="50"
								      HorizontalAlignment="Right"
								      Margin="-12,-46,-90,0"
								      Background="Transparent">
									<Control HorizontalAlignment="Left"
									         Margin="-12,0,0,0"
									         Foreground="{TemplateBinding Foreground}"
									         Template="{StaticResource Icon.WeatherStaticClock}" />
									<TextBlock HorizontalAlignment="Left"
									           VerticalAlignment="Center"
									           Margin="20,5,0,0"
									           Foreground="{TemplateBinding Foreground}"
									           FontWeight="Medium"
									           FontSize="17"
									           Style="{StaticResource Style.ARM_List_Text}"
									           Text="{TemplateBinding Tag}" />
								</Grid>
							</Border>
						</Grid>

						<Grid Grid.Row="1">
							<Grid.Resources>
								<Style TargetType="TextBlock" BasedOn="{StaticResource Style.ARM_List_Text}">
									<Setter Property="VerticalAlignment" Value="Center" />
									<Setter Property="Foreground" Value="{StaticResource NoiseBrush.Dark_Olive_Drab}" />
									<Setter Property="FontWeight" Value="Medium" />
									<Setter Property="app:BrushOffset.TargetProperty" Value="TextBlock.Foreground" />
									<Setter Property="FontSize" Value="17" />
								</Style>
							</Grid.Resources>
							<Grid.ColumnDefinitions>
								<ColumnDefinition />
								<ColumnDefinition Width="47" />
								<ColumnDefinition />
								<ColumnDefinition Width="47" />
								<ColumnDefinition />
								<ColumnDefinition Width="47" />
								<ColumnDefinition />
							</Grid.ColumnDefinitions>

							<TextBlock Grid.Column="0"
							           HorizontalAlignment="Center"
							           Text="06:00" />
							<TextBlock Grid.Column="2"
							           HorizontalAlignment="Center"
							           Text="12:00" />
							<TextBlock Grid.Column="4"
							           HorizontalAlignment="Center"
							           Text="18:00" />
							<TextBlock Grid.Column="6"
							           HorizontalAlignment="Center"
							           Text="00:00" />
						</Grid>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="Style.FlatButton.CareerWidget" TargetType="com:FlatButton" BasedOn="{StaticResource Style.FlatButton}">
		<Setter Property="OverridesDefaultStyle" Value="True" />
		<Setter Property="CornerRadius" Value="4" />
		<Setter Property="Background" Value="{StaticResource Brush.BG_paper}" />
		<Setter Property="HoverBackground" Value="{StaticResource Brush.BG_paper_light}" />
		<Setter Property="VerticalContentAlignment" Value="Stretch" />
		<Setter Property="Foreground" Value="{StaticResource Brush.Olive_Drab}" />
		<Setter Property="HoverForeground" Value="{StaticResource Brush.Olive_Drab}" />
		<Setter Property="Padding" Value="30,0,30,10" />
		<Setter Property="FontSize" Value="18" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="app:Focus.AdornerPadding" Value="-5" />
		<Setter Property="app:Focus.VisualStyle" Value="{StaticResource Style.FocusBrackets}" />
		<Setter Property="Tag" Value="{x:Null}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="com:FlatButton">
					<Border x:Name="Border"
					        Padding="{TemplateBinding Padding}"
					        CornerRadius="{TemplateBinding CornerRadius}"
					        Background="{TemplateBinding Background}">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="*" />
							</Grid.RowDefinitions>

							<Grid x:Name="Header"
							      Grid.Row="0"
							      Height="42">
								<TextBlock HorizontalAlignment="Center"
								           VerticalAlignment="Center"
								           Margin="0,2,0,0"
								           Foreground="{TemplateBinding Foreground}"
								           FontSize="14"
								           Style="{StaticResource Style.ARM_Title_2}"
								           Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}" />
							</Grid>

							<ContentPresenter Grid.Row="1"
							                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
							                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
							                  Focusable="False" />
						</Grid>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="Tag" Value="{x:Null}">
							<Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
