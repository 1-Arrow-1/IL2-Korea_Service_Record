	<app:ResourceKeyConverter x:Key="Career.StatusIcons_Plane">

		<ControlTemplate x:Key="Damaged">
			<Control x:Name="StatusIcon"
			         Background="{StaticResource Brush.Insignia_Red}"
			         Template="{StaticResource Template.Career_StatusProgress}" />
			<ControlTemplate.Triggers>
				<DataTrigger
					Binding="{Binding StatusProgress, Converter={StaticResource Less}, ConverterParameter={StaticResource Float0}}"
					Value="True">
					<Setter TargetName="StatusIcon" Property="Template" Value="{StaticResource Template.Career_UnknownStatusProgress}" />
