	<com:ContextMenuEx x:Key="ContextMenu.Career_UnitGroup_UnitMenu"
	                   Style="{StaticResource Style.ContextMenuEx_Career}"
	                   ItemsSource="{Binding Owner.Actions}"
	                   MenuItemCommand="{Binding Owner.MenuAction}"
	                   MenuOpeningCommand="{Binding Owner.MenuOpening}">
		<ContextMenu.ItemContainerStyle>
			<Style TargetType="MenuItem" BasedOn="{StaticResource Style.ContextMenuEx_Career_MenuItem}">
