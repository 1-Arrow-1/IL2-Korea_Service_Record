	<DockPanel>
		<HeaderedContentControl DockPanel.Dock="Top"
		                        Style="{StaticResource Style.HeaderedContentControl.Social.Header}"
		                        Header="{app:Localize carScreenHeader}"
		                        d:Header="Pilot Career"/>
		<com:RibbonDockPanel DockPanel.Dock="Bottom" Style="{StaticResource Style.Ribbon_ScreenFooter}">
			<com:FlatButton DockPanel.Dock="Left"
			                InputAction="gui_cancel"
			                Command="{Binding Close}"
			                Content="{app:Localize cmBack}"/>
		</com:RibbonDockPanel>


		<Grid>
			<Border Background="Black"
			        Opacity="0.8"
			        Visibility="{Binding IsNewDay, Converter={StaticResource IsFalseToVis}}"
			        d:Visibility="Collapsed"/>

			<Border Visibility="{Binding IsNewDay, Converter={StaticResource BoolToVis}}" d:Visibility="Visible">
				<Border.Background>
					<ImageBrush ImageSource="{StaticResource Menu.wood}"/>
				</Border.Background>
			</Border>

			<app:BoxShadow Width="1000"
			               Opacity="0.6"
			               BlurRadius="100" Direction="0"
			               Color="Black"/>

			<Border Width="1000"
			        Padding="20,20,20,40"
			        Background="{Binding IsNewDay, Converter={app:IfTrue {StaticResource Brush.BG_solidgreen}, Else={StaticResource Brush.BG_paper}}}"
			        d:Background="{StaticResource Brush.BG_solidgreen}">
				<!--<Border.Effect>
					<DropShadowEffect Opacity="0.6"
					                  BlurRadius="100" Direction="0"
					                  Color="Black"/>
				</Border.Effect>-->
				<Grid>

					<Grid.RowDefinitions>
						<RowDefinition Height="*"/>
						<RowDefinition Height="100"/>
					</Grid.RowDefinitions>

					<Control Grid.Row="0"
					         Style="{StaticResource Style.ContentControl.Event}"
					         DataContext="{Binding SelectedItem}"
					         d:Template="{StaticResource ControlTemplate.CommanderTemplate}"/>

					<StackPanel Grid.Row="1" VerticalAlignment="Bottom">
						<com:ListBoxEx Margin="0,0,0,24"
						               Style="{StaticResource Style.ListBox.Carousel}"
						               ItemsSource="{Binding Events}"
						               d:ItemsSource="{d:SampleData ItemCount=4}"
						               SelectedItem="{Binding SelectedItem}"/>

						<com:FlatButton Height="42"
						                MinWidth="180"
						                HorizontalAlignment="Center"
						                VerticalAlignment="Bottom"
						                app:Focus.OnLoad="SetFocus"
						                Style="{StaticResource Style.ButtonM}"
						                ImageDock="Left" InputAction="gui_accept"
						                Command="{Binding Next}"
						                Content="{app:Localize cmNext}"
						                d:Content="app:LocalizecmNext"/>
					</StackPanel>

				</Grid>
			</Border>

		</Grid>

	</DockPanel>
</UserControl>
