										<Border.Background>
											<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
												<GradientStop Offset="0" Color="{StaticResource Color.Insignia_White}"/>
												<GradientStop Offset="1" Color="#B9B09C"/>
											</LinearGradientBrush>
										</Border.Background>
									</Border>

									<Viewbox Grid.Row="0"
									         HorizontalAlignment="Center"
									         Margin="10"
									         Stretch="UniformToFill">
										<Image Source="{Binding Photo, Converter={StaticResource UriFormat}, ConverterParameter='{}/Assets/PilotPhotos/{0}.dds'}" d:Source="/Assets/Images/SmallPhotos/usa50e/48.png"/>
									</Viewbox>
									<Grid.Effect>
										<DropShadowEffect Opacity="0.5"
										                  BlurRadius="10" Direction="315"/>
									</Grid.Effect>
								</Grid>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<DockPanel Grid.Row="1">
						<HeaderedContentControl DockPanel.Dock="Top"
						                        Style="{StaticResource Style.HeaderedContentControl.Event}"
						                        Header="{Binding HeaderText}"
						                        Content="{Binding Text}"/>
						<Grid Margin="0,0,0,25">
							<ItemsControl Focusable="False"
							              ItemsSource="{Binding Pilots}"
							              d:ItemsSource="{d:SampleData ItemCount=6}">

								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<WrapPanel MaxHeight="110"
										           HorizontalAlignment="Center"
										           VerticalAlignment="Center"
										           Orientation="Vertical"
										           ItemWidth="Auto"/>
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<TextBlock HorizontalAlignment="Stretch"
										           Margin="18,2,18,2"
										           TextWrapping="NoWrap"
										           Style="{StaticResource Style.ARM_Title_Small_1_Adaptive_Color}">
											<Run Text="{Binding FirstName}"/> <Run Text="{Binding LastName}"/>
										</TextBlock>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</Grid>

					</DockPanel>
				</Grid>
			</ControlTemplate>

