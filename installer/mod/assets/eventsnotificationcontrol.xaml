					<DataTrigger Binding="{Binding Type}" Value="{x:Static app:NotificationType.CommanderKIA}">
						<Setter Property="Template" Value="{StaticResource ControlTemplate.CommanderTemplate}"/>
					</DataTrigger>
					<DataTrigger Binding="{Binding Type}" Value="{x:Static app:NotificationType.SupplyPilot}">
						<Setter Property="Template" Value="{StaticResource ControlTemplate.PilotsCommonTemplate}"/>
					</DataTrigger>
					<DataTrigger Binding="{Binding Type}" Value="{x:Static app:NotificationType.SupplyPilotOvercount}">
