						<Setter Property="Template" Value="{StaticResource ControlTemplate.NewDay}"/>
					</DataTrigger>
					<DataTrigger Binding="{Binding Type}" Value="{x:Static app:NotificationType.SkipDay}">
						<Setter Property="Template" Value="{StaticResource ControlTemplate.SkipDay}"/>
					</DataTrigger>
					<DataTrigger Binding="{Binding Type}" Value="{x:Static app:NotificationType.OperationStart}">
						<Setter Property="Template" Value="{StaticResource ControlTemplate.OperationStart}"/>
					</DataTrigger>
					<DataTrigger Binding="{Binding Type}" Value="{x:Static app:NotificationType.OperationFinish}">
