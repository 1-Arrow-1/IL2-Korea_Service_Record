					<DataTrigger Binding="{Binding Type}" Value="{x:Static app:NotificationType.SupplyPlaneOvercount}">
						<Setter Property="Template" Value="{StaticResource ControlTemplate.PlaneCommonTemplateOvercount}"/>
					</DataTrigger>
					<DataTrigger Binding="{Binding Type}" Value="{x:Static app:NotificationType.SupplyFuel}">
